{"id": "mm7144a2", "status": "invalid", "message_id": "msg_011Cgg9uSjBy1yxwcYQQCE2J", "model": "claude-haiku-5-5", "stop_reason": "end_turn", "errors": ["quote over 25 words: Global estimates of coverage with 3 doses of diphtheria-teta…"], "usage": {"input": 14524, "output": 3122}, "content": [{"signature": "", "thinking": "", "type": "thinking"}, {"text": "{\"id\": \"mm7144a2\", \"data_focus\": {\"v\": \"yes\", \"ev\": [{\"loc\": \"summary\", \"q\": \"Global estimates of coverage with 3 doses of diphtheria-tetanus-pertussis–containing vaccine (DTPcv3) decreased from an average of 86% during 2015–2019 to 83% in 2020 and 81% in 2021.\"}, {\"loc\": \"text\", \"q\": \"DTPcv3 coverage declined sharply in 17 countries that transitioned out of Gavi support\"}]}, \"outcome_types\": [{\"v\": \"binary/categorical\", \"ev\": [{\"loc\": \"text\", \"q\": \"WHO and UNICEF global estimates of national immunization coverage for DTPcv1 decreased from 90% in 2019 to 87% in 2020 and 86% in 2021\"}]}, {\"v\": \"count/rate\", \"ev\": [{\"loc\": \"text\", \"q\": \"In 2021, 25.0 million children worldwide had not completed the 3-dose DTPcv series\"}]}], \"analytic_depth\": [{\"v\": \"comparison\", \"ev\": [{\"loc\": \"text\", \"q\": \"whereas those supported by Gavi were less affected\"}, {\"loc\": \"text\", \"q\": \"The largest declines in MCV1 coverage during 2019–2021 occurred in the South-East Asia Region\"}]}], \"study_design\": [{\"v\": \"evaluation or monitoring\", \"ev\": [{\"loc\": \"text\", \"q\": \"DTPcv3 coverage by age 12 months is an indicator of routine immunization program performance\"}]}, {\"v\": \"before/after or trend\", \"ev\": [{\"loc\": \"text\", \"q\": \"Global coverage estimates were also lower in 2021 than in 2020 and 2019\"}]}], \"methods_quotes\": [{\"loc\": \"note\", \"q\": \"Survey-based vaccination coverage is calculated as the proportion of persons in a target age group who had received a vaccine dose.\"}, {\"loc\": \"note\", \"q\": \"administrative coverage is the number of doses administered in a specified target group divided by the estimated target population\"}, {\"loc\": \"note\", \"q\": \"For 18 countries that did not report 2021 immunization coverage data by July 7, 2021, estimated coverage for 2020 was used.\"}, {\"loc\": \"text\", \"q\": \"Finally, coverage estimates do not include statistical uncertainty.\"}, {\"loc\": \"text\", \"q\": \"from a weighted average of 82% in 2019 to 70% in 2021\"}], \"confidence\": \"medium\", \"uncertain_fields\": [\"data_focus\", \"study_design\"]}", "type": "text"}]}