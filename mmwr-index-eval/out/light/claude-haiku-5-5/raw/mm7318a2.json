n border.\"}]}], \"methods_quotes\": [{\"loc\": \"text\", \"q\": \"To describe imported malaria cases in these three jurisdictions, this report summarized patient travel and illness characteristics by U.S. residence status.\"}, {\"loc\": \"text\", \"q\": \"Malaria cases were defined according to CDC case definitions.\"}, {\"loc\": \"note\", \"q\": \"was identified using annual numbers of persons with credible fear who were released with a notice to appear for immigration court or paroled\"}], \"confidence\": \"medium\", \"uncertain_fields\": [\"outcome_types\"]}", "type": "text"}]}