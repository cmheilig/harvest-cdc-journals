{"id": "mm7214a3", "status": "ok", "message_id": "msg_011CggF1B6qFBEt1Y2NxRhZ1", "model": "claude-haiku-5-5", "stop_reason": "end_turn", "errors": [], "usage": {"input": 22716, "output": 3431}, "content": [{"signature": "", "thinking": "", "type": "thinking"}, {"text": "{\"id\": \"mm7214a3\", \"data_focus\": {\"v\": \"yes\", \"ev\": [{\"loc\": \"text\", \"q\": \"During 2022, acute flaccid paralysis (AFP) surveillance detected 127 paralytic cases, representing a 263% increase from 35 in 2020\"}, {\"loc\": \"text\", \"q\": \"19 of 29 (66%) outbreaks confirmed in 2021 had no virus detected after 120 days\"}]}, \"outcome_types\": [{\"v\": \"count/rate\", \"ev\": [{\"loc\": \"text\", \"q\": \"587 paralytic cVDPV2 cases were reported in 2022 (as of February 14, 2023)\"}]}, {\"v\": \"binary/categorical\", \"ev\": [{\"loc\": \"text\", \"q\": \"In 34 (45%) of the 76 active outbreaks, the latest detections occurred ≥13 months earlier\"}, {\"loc\": \"text\", \"q\": \"19 of 29 (66%) outbreaks confirmed in 2021 had no virus detected after 120 days\"}]}], \"analytic_depth\": [{\"v\": \"summary\", \"ev\": [{\"loc\": \"summary\", \"q\": \"76 cVDPV type 2 outbreaks occurred in 42 countries\"}]}, {\"v\": \"comparison\", \"ev\": [{\"loc\": \"text\", \"q\": \"compared with 28 (62%) of 45 outbreaks in 2019 and 27 (54%) of 50 in 2020\"}, {\"loc\": \"text\", \"q\": \"representing a 14% decrease from 682 in 2021 and a 46% decrease from 1,082 cases in 2020\"}]}], \"study_design\": [{\"v\": \"surveillance/descriptive\", \"ev\": [{\"loc\": \"text\", \"q\": \"This report describes global cVDPV outbreaks during January 2021–December 2022\"}]}, {\"v\": \"before/after or trend\", \"ev\": [{\"loc\": \"text\", \"q\": \"the reported number of paralytic cases has declined from the peak in 2020\"}]}, {\"v\": \"evaluation or monitoring\", \"ev\": [{\"loc\": \"text\", \"q\": \"the interruption of virus transmission in outbreaks (i.e., the latest detection) within 120 days\"}]}], \"methods_quotes\": [{\"loc\": \"text\", \"q\": \"when ≥13 months have passed since the onset of paralysis in the latest case or isolation sample date\"}, {\"loc\": \"text\", \"q\": \"the interruption of virus transmission in outbreaks (i.e., the latest detection) within 120 days\"}, {\"loc\": \"note\", \"q\": \"cVDPV outbreaks were suppressed if <6 months had elapsed from the 120th day following outbreak confirmation\"}, {\"loc\": \"note\", \"q\": \"Table is restricted to outbreaks with a last reported detection after November 1, 2021\"}], \"confidence\": \"high\", \"uncertain_fields\": [\"study_design\"]}", "type": "text"}]}