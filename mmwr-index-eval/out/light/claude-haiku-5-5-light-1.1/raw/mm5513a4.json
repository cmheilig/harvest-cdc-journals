ay\"}]}], \"methods_quotes\": [{\"loc\": \"note\", \"q\": \"The national baseline was calculated as the mean percentage of visits for ILI during noninfluenza weeks for the preceding three seasons, plus two standard deviations.\"}, {\"loc\": \"note\", \"q\": \"The epidemic threshold is 1.645 standard deviations above the seasonal baseline.\"}, {\"loc\": \"note\", \"q\": \"Noninfluenza weeks are those in which <10% of laboratory specimens are positive for influenza.\"}], \"confidence\": \"medium\", \"uncertain_fields\": [\"study_design\"]}", "type": "text"}]}