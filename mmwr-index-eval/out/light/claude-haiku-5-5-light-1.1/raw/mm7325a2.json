ods_quotes\": [{\"loc\": \"note\", \"q\": \"If the number of unvaccinated children in the sample exceeds three, the lot fails\"}, {\"loc\": \"note\", \"q\": \"The NPAFP rate was not calculated for regions with <100,000 persons aged <15 years.\"}, {\"loc\": \"text\", \"q\": \"Because a national census has not been conducted in >40 years, target population estimates are based on United Nations’ estimates.\"}, {\"loc\": \"note\", \"q\": \"The surveillance performance indicator target is three or more NPAFP cases per 100,000 persons aged <15 years per year.\"}], \"confidence\": \"medium\", \"uncertain_fields\": [\"study_design\"]}", "type": "text"}]}