itoring trends.\"}]}], \"methods_quotes\": [{\"loc\": \"text\", \"q\": \"Data were weighted to estimate population parameters.\"}, {\"loc\": \"text\", \"q\": \"CDC used statistical software to calculate unadjusted and adjusted proportions\"}, {\"loc\": \"text\", \"q\": \"After adjustment, CDC examined differences in proportions across agreement categories for both questions\"}, {\"loc\": \"text\", \"q\": \"The analyses excluded persons who responded \\\"did not know\\\" or \\\"refused\\\" to answer the questions.\"}, {\"loc\": \"table 1\", \"q\": \"Estimates are weighted; sample size is unweighted.\"}], \"confidence\": \"high\", \"uncertain_fields\": []}", "type": "text"}]}