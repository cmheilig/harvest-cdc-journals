{"id": "mm6945a7", "status": "ok", "message_id": "msg_011CggGUyTk5e4Za87pUhsDr", "model": "claude-haiku-5-5", "stop_reason": "end_turn", "errors": [], "usage": {"input": 12826, "output": 4060}, "content": [{"signature": "", "thinking": "", "type": "thinking"}, {"text": "{\"id\": \"mm6945a7\", \"data_focus\": {\"v\": \"yes\", \"ev\": [{\"loc\": \"text\", \"q\": \"Worldwide, 19.7 million children (15%) were not vaccinated with DTP3 in 2019, 13.8 million (70%) of whom were zero-dose children.\"}, {\"loc\": \"text\", \"q\": \"In 2019, overall DTP1-to-DTP3 dropout was 6%\"}]}, \"outcome_types\": [{\"v\": \"binary/categorical\", \"ev\": [{\"loc\": \"text\", \"q\": \"Global coverage with the second MCV dose (MCV2) increased from 42% in 2010 to 71% in 2019.\"}]}, {\"v\": \"count/rate\", \"ev\": [{\"loc\": \"table 2\", \"q\": \"No. of zero-dose children (millions)\"}, {\"loc\": \"text\", \"q\": \"the number of zero-dose children increased in the African region (from 6.1 million to 6.8 million)\"}]}], \"analytic_depth\": [{\"v\": \"summary\", \"ev\": [{\"loc\": \"text\", \"q\": \"In 2019, 90% of children received at least 1 DTP dose and 85% received 3 DTP doses\"}]}, {\"v\": \"comparison\", \"ev\": [{\"loc\": \"text\", \"q\": \"the number of zero-dose children increased in the African region (from 6.1 million to 6.8 million)\"}, {\"loc\": \"text\", \"q\": \"In 2000, low-income countries accounted for the highest percentage of zero-dose children (88%; 18.9 million)\"}]}], \"study_design\": [{\"v\": \"surveillance/descriptive\", \"ev\": [{\"loc\": \"text\", \"q\": \"derive national vaccination coverage estimates through annual country-by-country review of available data\"}]}, {\"v\": \"before/after or trend\", \"ev\": [{\"loc\": \"text\", \"q\": \"During 2010–2019, the number of zero-dose children increased in the African region\"}]}], \"methods_quotes\": [{\"loc\": \"note\", \"q\": \"Survey-based vaccination coverage is calculated as the proportion of persons in a target age group who received a vaccine dose.\"}, {\"loc\": \"text\", \"q\": \"DTP1-to-DTP3 dropout, an indicator of immunization program utilization, is calculated as the percentage of children who received DTP1 but not DTP3.\"}, {\"loc\": \"text\", \"q\": \"derive national vaccination coverage estimates through annual country-by-country review of available data\"}], \"confidence\": \"high\", \"uncertain_fields\": []}", "type": "text"}]}