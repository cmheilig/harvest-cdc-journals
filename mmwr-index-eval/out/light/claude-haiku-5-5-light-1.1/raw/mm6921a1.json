\"methods_quotes\": [{\"loc\": \"text\", \"q\": \"T-tests were used to determine whether prevalence of each category of tooth loss varied by chronic disease status\"}, {\"loc\": \"text\", \"q\": \"which accounted for the examination sample weights and the complex, clustered design of NHANES.\"}, {\"loc\": \"table 2\", \"q\": \"Statistically significant (p<0.05).\"}, {\"loc\": \"table 2\", \"q\": \"Prevalence in group with condition divided by prevalence in those without condition.\"}, {\"loc\": \"figure 1\", \"q\": \"Change in prevalence is statistically significant (p<0.05) for all conditions except asthma, emphysema, heart disease, liver condition, and stroke.\"}], \"confidence\": \"medium\", \"uncertain_fields\": [\"analytic_depth\"]}", "type": "text"}]}