sed\"}, {\"loc\": \"text\", \"q\": \"with adjustment for work site among warehouse employees\"}, {\"loc\": \"text\", \"q\": \"Data were analyzed using Stata (version 15; StataCorp).\"}], \"confidence\": \"high\", \"uncertain_fields\": []}", "type": "text"}]}