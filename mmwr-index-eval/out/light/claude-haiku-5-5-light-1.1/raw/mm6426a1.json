}], \"methods_quotes\": [{\"loc\": \"text\", \"q\": \"Balanced repeated replication technique, replicate weights, and Taylor linearization were used to compute standard errors and confidence intervals\"}, {\"loc\": \"text\", \"q\": \"Predicted probabilities were weighted and averaged across all respondents and in each state\"}, {\"loc\": \"text\", \"q\": \"age- and sex-specific logistic regression models that estimate probabilities of meeting recommendations\"}, {\"loc\": \"note\", \"q\": \"Estimates are weighted to account for complex sampling using statistical software except where noted\"}], \"confidence\": \"medium\", \"uncertain_fields\": [\"study_design\"]}", "type": "text"}]}