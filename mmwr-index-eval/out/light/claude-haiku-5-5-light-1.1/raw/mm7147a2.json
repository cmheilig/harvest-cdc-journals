}]}, {\"v\": \"before/after or trend\", \"ev\": [{\"loc\": \"text\", \"q\": \"representing 40% and 34% reductions in human cases and animal infections\"}]}], \"methods_quotes\": [{\"loc\": \"note\", \"q\": \"The denominator is number of villages with endemic human dracunculiasis during 2020–2021.\"}, {\"loc\": \"note\", \"q\": \"Human cases are contained when all of the following criteria are met\"}, {\"loc\": \"note\", \"q\": \"Because D. medinensis has a 10–14-month incubation period, each infected person is counted as having a case only once during a calendar year.\"}], \"confidence\": \"medium\", \"uncertain_fields\": [\"study_design\"]}", "type": "text"}]}