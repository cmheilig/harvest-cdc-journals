, {\"v\": \"evaluation or monitoring\", \"ev\": [{\"loc\": \"text\", \"q\": \"highlight the importance of local and national program monitoring and evaluation efforts\"}, {\"loc\": \"text\", \"q\": \"A primary goal of the National HIV/AIDS Strategy is to link 85.0% of all new positives to HIV medical care within 90 days\"}]}], \"methods_quotes\": [{\"loc\": \"text\", \"q\": \"both minimum and maximum percentages were calculated\"}, {\"loc\": \"text\", \"q\": \"were analyzed and stratified by 23 site types in health care and non–health care settings\"}, {\"loc\": \"note\", \"q\": \"The minimum was calculated by including missing/invalid data in the denominator\"}], \"confidence\": \"medium\", \"uncertain_fields\": [\"analytic_depth\", \"outcome_types\"]}", "type": "text"}]}