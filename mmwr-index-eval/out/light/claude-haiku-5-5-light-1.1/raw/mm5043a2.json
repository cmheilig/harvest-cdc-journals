.\"}]}], \"methods_quotes\": [{\"loc\": \"text\", \"q\": \"Major CVD rates were age-adjusted to the 2000 U.S. standard population\"}, {\"loc\": \"text\", \"q\": \"SUDAAN was used to calculate all estimates and their standard errors because of the complex sample designs of NIS and NHIS.\"}, {\"loc\": \"text\", \"q\": \"a t-test in SUDAAN was used to assess the difference\"}, {\"loc\": \"text\", \"q\": \"Trends were assessed by age for major CVD prevalence and for hospital discharge rates, rate ratios, and rate differences.\"}, {\"loc\": \"text\", \"q\": \"Rate ratios and rate differences were calculated for both major CVD prevalence and hospital discharge rates\"}], \"confidence\": \"medium\", \"uncertain_fields\": [\"study_design\"]}", "type": "text"}]}