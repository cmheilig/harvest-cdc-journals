tes\": [{\"loc\": \"text\", \"q\": \"the number of nonpolio AFP cases per 100,000 population aged <15 years\"}, {\"loc\": \"note\", \"q\": \"SIA quality is defined by the percentage of houses detected, after a vaccination activity has been completed\"}, {\"loc\": \"note\", \"q\": \"high-risk blocks are those with at least two polio cases from 2001 until week 28 of 2007\"}], \"confidence\": \"high\", \"uncertain_fields\": [\"study_design\"]}", "type": "text"}]}