to village population size.\"}, {\"loc\": \"text\", \"q\": \"Cause of death was assigned using standard case definitions for easily recognized causes of death.\"}, {\"loc\": \"text\", \"q\": \"Analysis was performed using EpiInfo version 6.04b\"}, {\"loc\": \"text\", \"q\": \"comparing verbal reports of mothers with case definitions was used to determine causes of death\"}], \"confidence\": \"medium\", \"uncertain_fields\": [\"study_design\"]}", "type": "text"}]}