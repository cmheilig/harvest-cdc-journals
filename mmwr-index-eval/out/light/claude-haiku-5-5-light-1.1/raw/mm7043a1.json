{"id": "mm7043a1", "status": "ok", "message_id": "msg_011CggGUhtskVvtTvqNxyKcK", "model": "claude-haiku-5-5", "stop_reason": "end_turn", "errors": [], "usage": {"input": 14459, "output": 4372}, "content": [{"signature": "", "thinking": "", "type": "thinking"}, {"text": "{\"id\": \"mm7043a1\", \"data_focus\": {\"v\": \"yes\", \"ev\": [{\"loc\": \"text\", \"q\": \"the number of children who did not complete the 3-dose DTP series increased by 20% to 22.7 million from 2019 to 2020\"}, {\"loc\": \"summary\", \"q\": \"In 2020, estimated global coverage with DTP3 and Pol3 decreased to 83%\"}]}, \"outcome_types\": [{\"v\": \"binary/categorical\", \"ev\": [{\"loc\": \"text\", \"q\": \"From 2019 to 2020, global coverage declined from 90% to 87% for DTP1 and from 86% to 83% for DTP3\"}]}, {\"v\": \"count/rate\", \"ev\": [{\"loc\": \"table 2\", \"q\": \"No. of zero-dose children (millions)\"}]}], \"analytic_depth\": [{\"v\": \"summary\", \"ev\": [{\"loc\": \"text\", \"q\": \"MCV1 coverage in 2020 ranged from 68% in the African Region to 95% in the Western Pacific Region\"}]}, {\"v\": \"comparison\", \"ev\": [{\"loc\": \"text\", \"q\": \"From 2019 to 2020, global MCV1 coverage decreased to the 2014 level of 84%\"}, {\"loc\": \"text\", \"q\": \"the number of zero-dose children was stable in the European Region at 0.3 million but increased in the African\"}]}], \"study_design\": [{\"v\": \"surveillance/descriptive\", \"ev\": [{\"loc\": \"text\", \"q\": \"presents global, regional,* and national vaccination coverage estimates and trends as of 2020\"}]}, {\"v\": \"before/after or trend\", \"ev\": [{\"loc\": \"text\", \"q\": \"WHO and UNICEF estimates during 2010–2019 indicate that global coverage with the DTP series stagnated\"}, {\"loc\": \"text\", \"q\": \"Changes are described in vaccination coverage and the numbers of unvaccinated and undervaccinated children\"}]}], \"methods_quotes\": [{\"loc\": \"text\", \"q\": \"WHO and UNICEF derive national vaccination coverage estimates through annual country-by-country review of available data, including administrative and survey-based coverage\"}, {\"loc\": \"note\", \"q\": \"Administrative coverage is the number of vaccine doses administered to persons in a specified target group divided by the estimated target population\"}, {\"loc\": \"note\", \"q\": \"For 35 countries that did not report immunization coverage data for 2020 by July 6, 2021, estimated coverage in 2019 was used\"}, {\"loc\": \"text\", \"q\": \"estimates do not include statistical uncertainty\"}], \"confidence\": \"high\", \"uncertain_fields\": []}", "type": "text"}]}