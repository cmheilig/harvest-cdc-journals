\": [{\"loc\": \"text\", \"q\": \"Since 2000, India has exceeded the WHO-established AFP surveillance quality targets\"}]}], \"methods_quotes\": [{\"loc\": \"note\", \"q\": \"Two specimens collected > 24 hours apart, both within 14 days of paralysis onset and shipped properly to the laboratory.\"}, {\"loc\": \"text\", \"q\": \"nonpolio AFP rate of > 1 per 100,000 population aged <15 years\"}, {\"loc\": \"text\", \"q\": \"vaccination coverage data for AFP cases that were not caused by polioviruses\"}, {\"loc\": \"note\", \"q\": \"Data as of February 28, 2004.\"}], \"confidence\": \"medium\", \"uncertain_fields\": [\"analytic_depth\", \"study_design\"]}", "type": "text"}]}