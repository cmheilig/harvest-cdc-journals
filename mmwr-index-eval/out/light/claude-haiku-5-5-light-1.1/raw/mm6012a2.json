amydia screening\"}]}, {\"v\": \"surveillance/descriptive\", \"ev\": [{\"loc\": \"figure 1\", \"q\": \"Chlamydia prevalence among sexually active persons, by age group --- United States, 1999--2008\"}]}], \"methods_quotes\": [{\"loc\": \"figure 1\", \"q\": \"combined to provide stable estimates for all subgroups\"}, {\"loc\": \"figure 1\", \"q\": \"All relative standard errors <30%.\"}, {\"loc\": \"figure 1\", \"q\": \"Based on a \\\"yes\\\" response to the question, \\\"Have you ever had sex?\\\"\"}, {\"loc\": \"figure 2\", \"q\": \"Defined as persons who had a claim or visit for pregnancy\"}], \"confidence\": \"medium\", \"uncertain_fields\": [\"data_focus\", \"study_design\"]}", "type": "text"}]}