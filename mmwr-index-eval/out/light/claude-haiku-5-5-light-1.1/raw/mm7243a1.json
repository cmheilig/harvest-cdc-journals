{"id": "mm7243a1", "status": "ok", "message_id": "msg_011CggEyyVK4WbkQPDuiPrJn", "model": "claude-haiku-5-5", "stop_reason": "end_turn", "errors": [], "usage": {"input": 17341, "output": 5178}, "content": [{"signature": "", "thinking": "", "type": "thinking"}, {"text": "{\"id\": \"mm7243a1\", \"data_focus\": {\"v\": \"yes\", \"ev\": [{\"loc\": \"summary\", \"q\": \"coverage ≥1 dose of DTPcv1 increased from 86% in 2021 to 89% in 2022\"}, {\"loc\": \"text\", \"q\": \"In 2022, low-income countries reported the highest DTPcv1-to-MCV1 dropout (17%)\"}]}, \"outcome_types\": [{\"v\": \"binary/categorical\", \"ev\": [{\"loc\": \"text\", \"q\": \"In 2022, low-income countries reported the highest DTPcv1-to-MCV1 dropout (17%)\"}]}, {\"v\": \"count/rate\", \"ev\": [{\"loc\": \"summary\", \"q\": \"Worldwide in 2022, 14.3 million children were not vaccinated with DTPcv1\"}]}], \"analytic_depth\": [{\"v\": \"summary\", \"ev\": [{\"loc\": \"text\", \"q\": \"In 2022, most (84%) zero-dose children lived in low- and lower-middle–income countries\"}]}, {\"v\": \"comparison\", \"ev\": [{\"loc\": \"text\", \"q\": \"Only AFR reported an increase in zero-dose children from 2021 to 2022\"}]}], \"study_design\": [{\"v\": \"evaluation or monitoring\", \"ev\": [{\"loc\": \"summary\", \"q\": \"documents progress toward improving coverage with respect to the IA2030 strategy\"}]}, {\"v\": \"before/after or trend\", \"ev\": [{\"loc\": \"summary\", \"q\": \"This report reviews trends in World Health Organization and UNICEF immunization coverage estimates\"}]}, {\"v\": \"surveillance/descriptive\", \"ev\": [{\"loc\": \"summary\", \"q\": \"This report reviews trends in World Health Organization and UNICEF immunization coverage estimates\"}]}], \"methods_quotes\": [{\"loc\": \"text\", \"q\": \"WHO and UNICEF produce Estimates of National Immunization Coverage (WUENIC) at the national, regional, and global level based on review of country-specific data\"}, {\"loc\": \"text\", \"q\": \"DTPcv1-to-DTPcv3 and DTPcv1-to-MCV1 dropout rates were calculated as the percentage of children who received DTPcv1 but not DTPcv3 or MCV1, respectively.\"}, {\"loc\": \"note\", \"q\": \"Economic classification is based on gross national income (GNI) per capita, calculated using the World Bank Atlas method\"}, {\"loc\": \"note\", \"q\": \"Survey-based vaccination coverage is calculated as the proportion of persons in a target age group who had received a vaccine dose.\"}, {\"loc\": \"text\", \"q\": \"Fourth, coverage estimates do not include statistical uncertainty.\"}], \"confidence\": \"medium\", \"uncertain_fields\": [\"data_focus\", \"study_design\"]}", "type": "text"}]}