, \"ev\": [{\"loc\": \"title\", \"q\": \"Monitoring Incidence of COVID-19 Cases, Hospitalizations, and Deaths, by Vaccination Status\"}, {\"loc\": \"summary\", \"q\": \"monitoring COVID-19 incidence by vaccination status might provide early signals of potential changes in vaccine effectiveness\"}]}], \"methods_quotes\": [{\"loc\": \"text\", \"q\": \"95% CIs were calculated to account for variation in weekly rates.\"}, {\"loc\": \"text\", \"q\": \"Average weekly incidence in each period was age standardized using the 2000 U.S. Census standard population.\"}, {\"loc\": \"text\", \"q\": \"PVC was calculated using VE estimates of 80%, 90%, and 95%.\"}, {\"loc\": \"text\", \"q\": \"A sensitivity analysis examined the impact of excluding partially vaccinated persons from IRRs using data available from nine jurisdictions.\"}, {\"loc\": \"text\", \"q\": \"To aid interpretation of changes in IRRs, age-standardized crude VE was estimated as\"}], \"confidence\": \"high\", \"uncertain_fields\": [\"study_design\"]}", "type": "text"}]}