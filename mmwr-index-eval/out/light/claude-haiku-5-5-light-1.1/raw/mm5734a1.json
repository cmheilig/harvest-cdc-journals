ptive\", \"ev\": [{\"loc\": \"text\", \"q\": \"Cases were distributed among 43 states, the District of Columbia, and Canada\"}]}], \"methods_quotes\": [{\"loc\": \"text\", \"q\": \"On multiple logistic regression, illness was significantly associated only with eating salsa\"}, {\"loc\": \"text\", \"q\": \"After adjusting for sex, Hispanic ethnicity, and additional age variation,\"}, {\"loc\": \"text\", \"q\": \"Illness remained significantly associated with eating raw tomatoes (mOR = 5.6) after adjusting for consumption of tortillas\"}, {\"loc\": \"text\", \"q\": \"Controls were well persons in the community matched by age and location using reverse telephone directories\"}, {\"loc\": \"text\", \"q\": \"and compared the presence of specific foods in the household regardless of whether the respondent remembered eating them\"}], \"confidence\": \"high\", \"uncertain_fields\": [\"outcome_types\"]}", "type": "text"}]}