ry state\"}]}, {\"v\": \"ecologic\", \"ev\": [{\"loc\": \"text\", \"q\": \"compared between U.S. counties in highest and lowest quintiles of teen birth rates\"}]}], \"methods_quotes\": [{\"loc\": \"text\", \"q\": \"Changes over time were evaluated using a Z-test\"}, {\"loc\": \"text\", \"q\": \"through a comparison of Poisson probability distributions\"}, {\"loc\": \"text\", \"q\": \"to provide reliable estimates for each race/ethnicity group (numerators ≥20)\"}, {\"loc\": \"text\", \"q\": \"County-specific data were reported for 2013–2014 combined, and excluded counties with <20 teen births in total\"}, {\"loc\": \"text\", \"q\": \"T-tests were used to evaluate differences (p<0.05).\"}], \"confidence\": \"high\", \"uncertain_fields\": [\"analytic_depth\"]}", "type": "text"}]}