}, {\"v\": \"before/after or trend\", \"ev\": [{\"loc\": \"text\", \"q\": \"From 2005 to 2009, death rates declined significantly from 1.34 per 100,000 to 1.25\"}]}], \"methods_quotes\": [{\"loc\": \"text\", \"q\": \"Significant differences (p<0.05) between rates were determined using a t-test for nonfatal drowning rates and a z-test for death rates.\"}, {\"loc\": \"text\", \"q\": \"Confidence intervals were calculated using statistical software to account for the complex sample design.\"}, {\"loc\": \"text\", \"q\": \"Each case was assigned a sample weight on the basis of the inverse probability of selection; these weights were summed to provide national estimates.\"}, {\"loc\": \"text\", \"q\": \"Because of the small sample size, percentages of nonfatal injuries for location by age group were based on unweighted data\"}, {\"loc\": \"text\", \"q\": \"Rates were calculated using U.S. Census bridged-race intercensal population estimates\"}], \"confidence\": \"high\", \"uncertain_fields\": [\"analytic_depth\"]}", "type": "text"}]}